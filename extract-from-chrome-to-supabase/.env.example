# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_API_KEY=YOUR_ANON_KEY
# Write endpoints (insert-links) need an authenticated user. Provide login
# credentials for the password-grant flow; leave blank to read-only / apikey.
SUPABASE_EMAIL=you@example.com
SUPABASE_PASSWORD=your-password
MOCK=true

# AI categorizer fallback (optional — leave blank to use keywords only)
# AI_PROVIDER: "openai" or "anthropic"
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5-20251001
